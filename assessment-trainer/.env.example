# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Python interpreter with opencv-python-headless + numpy installed
PYTHON_BIN="python3"

# AI providers (optional). "local" = OpenCV + tesseract.js only, nothing leaves the machine.
VISION_PROVIDER="local"     # local | anthropic
TEXT_PROVIDER="local"       # local | anthropic
REASONING_PROVIDER="local"  # local | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Where uploaded screenshots are stored when the user enables image storage
UPLOAD_DIR="./data/uploads"
