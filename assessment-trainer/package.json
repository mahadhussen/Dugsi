{
  "name": "assessment-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Local training tool for Matrigma-like matrices and MAP-like personality statements (practice only)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python3 -m pytest python/tests -q",
    "test:all": "vitest run && python3 -m pytest python/tests -q && tsx scripts/benchmark.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:vision": "tsx scripts/vision-benchmark.ts",
    "test-data": "tsx scripts/generate-test-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^6.19.3",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
